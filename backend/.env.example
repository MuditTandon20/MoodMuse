# MoodMuse Studio - Environment Configuration
# Copy this file to .env and fill in your credentials

# Hugging Face API Token (free at https://huggingface.co/settings/tokens)
# Required for music generation via MusicGen
HF_API_TOKEN=

# Optional: Replicate API Token (https://replicate.com/account/api-tokens)
# REPLICATE_API_TOKEN=

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
MAX_GENERATIONS_PER_HOUR=10
MAX_GENERATIONS_PER_DAY=50

# Storage
STORAGE_DIR=./storage
MAX_STORED_CREATIONS=100
